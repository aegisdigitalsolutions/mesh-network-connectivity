diff --git a/src/tun.c b/src/tun.c
--- a/src/tun.c
+++ b/src/tun.c
@@ -1,5 +1,7 @@
 #include "common.h"
+#include <stdlib.h>
+#include <fcntl.h>
 
 #include <fcntl.h>
 #include <sys/ioctl.h>
@@ int
 tun_create(char *name, size_t size)
 {
+    /* MeshLink Android: accept an externally created tun fd (VpnService).
+       When GT_TUN_FD is set we must not touch /dev/net/tun. */
+    const char *env_fd = getenv("GT_TUN_FD");
+
+    if (env_fd && env_fd[0]) {
+        int fd = (int)strtol(env_fd, NULL, 10);
+        if (fd < 0) {
+            gt_log("bad GT_TUN_FD\n");
+            return -1;
+        }
+        int fl = fcntl(fd, F_GETFL, 0);
+        if (fl != -1)
+            fcntl(fd, F_SETFL, fl | O_NONBLOCK);
+        snprintf(name, size, "tun-vpn");
+        return fd;
+    }
+
     int fd = open("/dev/net/tun", O_RDWR);
 
     if (fd < 0)
@@ int
 tun_set_mtu(char *dev_name, int mtu)
 {
+    /* MeshLink Android: MTU/addr/up are configured by VpnService.Builder.
+       These ioctls EPERM on unrooted Android and must be skipped. */
+    if (getenv("GT_TUN_FD"))
+        return 0;
+
     struct ifreq ifr = {
         .ifr_mtu = mtu,
     };
